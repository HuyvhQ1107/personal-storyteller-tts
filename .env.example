# Copy to `.env` and fill in your values.
# Anything left blank falls back to the defaults in `personal_storyteller/config.py`.

# HuggingFace model used for story generation.
# Default matches the original lab notebook.
STORYTELLER_MODEL_ID=Qwen/Qwen2.5-3B-Instruct

# Generation parameters (see config.py for full options)
STORYTELLER_MAX_NEW_TOKENS=500
STORYTELLER_DO_SAMPLE=false

# gTTS settings
STORYTELLER_TTS_LANG=en
STORYTELLER_TTS_SLOW=false

# Output directory for saved audio
STORYTELLER_OUTPUT_DIR=output

# Optional: HuggingFace token, only needed for gated models (e.g. Llama, Mistral 7B).
# Get one at https://huggingface.co/settings/tokens
# HF_TOKEN=